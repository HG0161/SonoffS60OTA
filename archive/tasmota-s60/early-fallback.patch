 void setup(void) {
+#ifdef S60_OTA_TRIAL
+  /* Keep the OTA bridge as the next-boot fallback.  This deliberately runs
+   * before settings, GPIO, Wi-Fi, web and driver initialization. */
+  const esp_partition_t *s60_running = esp_ota_get_running_partition();
+  const esp_partition_t *s60_peer = esp_ota_get_next_update_partition(nullptr);
+  if ((nullptr != s60_running) && (nullptr != s60_peer) &&
+      (s60_running != s60_peer) &&
+      (ESP_PARTITION_TYPE_APP == s60_peer->type)) {
+    esp_ota_set_boot_partition(s60_peer);
+  }
+#endif  // S60_OTA_TRIAL
 #ifdef ESP32
 #ifdef CONFIG_IDF_TARGET_ESP32
