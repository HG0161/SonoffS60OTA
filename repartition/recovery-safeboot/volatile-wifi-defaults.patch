+#ifdef S60_RECOVERY_WIFI_DEFAULTS
+#ifndef FIRMWARE_SAFEBOOT
+#error S60_RECOVERY_WIFI_DEFAULTS is restricted to FIRMWARE_SAFEBOOT
+#endif
+  // Safeboot deliberately does not create or persist defaults when NVS is
+  // absent or unreadable.  This recovery-only build instead recreates the
+  // compiled defaults in RAM on every boot.  SettingsDefaultSet2() copies
+  // STA_SSID1 and STA_PASS1 into the volatile Settings text pool; SettingsSave
+  // remains disabled by FIRMWARE_MINIMAL.
+  SettingsDefaultSet1();
+  SettingsDefaultSet2();
+  settings_location = 0;
+  AddLog(LOG_LEVEL_INFO, PSTR("S60 recovery Wi-Fi defaults active"));
+#endif
